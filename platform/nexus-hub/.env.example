# Studex Nexus Hub — env template
# Copy to .env and fill in real values before docker compose up.

# n8n hostname (used for webhook URLs). Set once Cloudflare Tunnel is wired.
N8N_HOST=n8n.studex.co.za

# n8n encryption key — GENERATE ONCE:
#   openssl rand -hex 32
N8N_ENCRYPTION_KEY=

# Postgres password for n8n's DB — GENERATE ONCE:
#   openssl rand -base64 24
DB_PASSWORD=

# Cloudflare Tunnel token — get from:
#   Cloudflare dashboard -> Zero Trust -> Networks -> Tunnels -> Create Tunnel
#   Copy the token from the "Install and run" step
CLOUDFLARE_TUNNEL_TOKEN=
